# Copy to .env and fill in your own values.
PORT=3000
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/eventpass
# Only used by `npm test`; the test suite wipes this database.
DATABASE_URL_TEST=postgres://postgres:YOUR_PASSWORD@localhost:5432/eventpass_test
# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# 32 random bytes, base64. Encrypts each event's private signing key at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KEY_ENCRYPTION_KEY=
CORS_ORIGIN=*
